# Render API base URL. Use HTTPS.
TRADF_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the exact same secret in Render environment variables.
TRADF_MT5_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MT5_BRIDGE_ID=windows-demo-bridge-01
# Leave empty if the MT5 terminal is already installed in its default location.
MT5_TERMINAL_PATH=
# Backfill up to 9000 bars per symbol/timeframe. 7000 M5 bars covers about 24 days.
MT5_HISTORY_BARS=7000
MT5_POLL_SECONDS=30
# Optional broker suffix overrides, e.g. {"EURUSD":"EURUSD.a","XAUUSD":"GOLD"}
MT5_SYMBOL_MAP=
LOG_LEVEL=INFO
