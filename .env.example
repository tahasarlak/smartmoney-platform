APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000
# Local Docker example. In GitHub Actions use Neon pooled/direct URLs as secrets.
DATABASE_URL=postgresql+psycopg://smartmoney:smartmoney@db:5432/smartmoney
DIRECT_URL=postgresql+psycopg://smartmoney:smartmoney@db:5432/smartmoney
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0
BINANCE_BASE_URL=https://api.binance.com
LIVE_TRADING_ENABLED=false
